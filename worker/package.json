{
  "name": "watanabe-board-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Bulletin board backend for Watanabe Group site (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute watanabe-board --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute watanabe-board --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute watanabe-board --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute watanabe-board --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
